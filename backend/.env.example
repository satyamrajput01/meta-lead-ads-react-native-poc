# ================================================================
# Meta Lead Ads + React Native PoC - Backend Environment Variables
# ================================================================

# Port on which the Express server and Socket.IO listener runs
PORT=3000

# SQLite or local database path/URL
DATABASE_URL="file:./data/leads_poc.db"

# Secret key used to sign and verify JWT authentication tokens
# In production, use a strong cryptographically secure random string (e.g. openssl rand -hex 32)
JWT_SECRET="super-secret-jwt-key-replace-in-production"

# Verification token entered in Meta Developer Portal -> Webhooks -> Page
# Meta uses this during webhook verification (hub.verify_token)
META_VERIFY_TOKEN="meta_lead_ads_poc_verify_secret_token_123"

# System User or Page Access Token with 'leads_retrieval' and 'pages_manage_ads' permissions
# Used to query Meta Graph API: GET https://graph.facebook.com/v19.0/{leadgen_id}
META_ACCESS_TOKEN="EAA..."

# Default Meta Page ID associated with the lead generation forms
# Used for mapping incoming leads to user accounts
META_PAGE_ID="109823478912345"

# Optional App Secret for validating Meta's X-Hub-Signature-256 header (HMAC SHA-256)
META_APP_SECRET="your_meta_app_secret_here"

# Default application user ID to assign unmapped leads to (fallback user mapping)
DEFAULT_LEAD_USER_ID="user_1"
